# Kredensial Bot PPOB & Toko Digital (WhatsApp & Telegram)
PORT=3000

# WhatsApp Owner / Admin (Format Internasional: Awalan 62)
OWNER_NUMBER=6281234567890

# Digiflazz Gateway API (https://digiflazz.com)
DIGIFLAZZ_USERNAME=your_digiflazz_username
DIGIFLAZZ_KEY=your_digiflazz_production_api_key

# PaymentKita Gateway QRIS Realtime (https://paymentkita.com)
PAYMENTKITA_MERCHANT_ID=PKMxxxxxxxx
PAYMENTKITA_SECRET=PKSK_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Command Center (Opsional - untuk notifikasi & remote backup)
TELEGRAM_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Pakasir Gateway (Legacy/Opsional)
PAKASIR_PROJECT=Ansor
PAKASIR_KEY=your_pakasir_key
